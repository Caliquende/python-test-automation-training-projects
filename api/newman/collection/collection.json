                                            "const jsonData = pm.response.json();\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Body object type is an object\", function () {\r\n    pm.expect(jsonData).to.be.an(\"object\");\r\n});\r\n\r\npm.test(\"Body has a products array\", function () {\r\n    pm.expect(jsonData).to.have.property(\"products\").that.is.an(\"array\");\r\n});\r\n\r\npm.test(\"Body has numeric pagination fields\", function () {\r\n    pm.expect(jsonData).to.have.property(\"total\").that.is.a(\"number\");\r\n    pm.expect(jsonData).to.have.property(\"skip\").that.is.a(\"number\");\r\n    pm.expect(jsonData).to.have.property(\"limit\").that.is.a(\"number\");\r\n});\r\n\r\npm.test(\"Products count should match limit value\", function () {\r\n    pm.expect(jsonData.products.length).to.be.at.most(jsonData.limit);\r\n});\r\n\r\npm.test (\"Is header formatted as Json\", function () {\r\n    const contentType = pm.response.headers.get(\"Content-Type\");\r\n    pm.expect(contentType).to.include(\"application/json; charset=utf-8\");\r\n});\r\n\r\npm.test(\"Is response time less than 1000ms\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(1000);\r\n});"
